# ==============================================================================
# SALVUS BACKEND - Environment Variables Template
# Copy this file to `.env` for local development.
# On Render / Production: Set these variables in the Render Dashboard Environment tab.
# NEVER commit `.env` or real API keys/secrets to version control.
# ==============================================================================

# Server & Runtime Configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# CORS Configuration
# Comma-separated allowed origins in production, e.g.:
# CORS_ORIGIN=https://salvus.vercel.app,https://salvus-frontend.onrender.com,http://localhost:5173
CORS_ORIGIN=*

# Database Configuration
# Local/Render free tier: data/salvus.db
# Render persistent disk (Starter tier): /var/data/salvus.db
DATABASE_PATH=data/salvus.db

# Auto-Seeding (set to 'true' to ensure fresh databases seed disaster infrastructure)
AUTO_SEED=true

# Security & Secrets (generate a random 32+ character string in production)
SECRET_KEY=

# Routing & Geospatial Emergency Services
OSRM_BASE_URL=https://router.project-osrm.org
# Real-World Nearby Facilities Provider Keys (Primary: Geoapify | Fallback: Google Places / OSM)
GEOAPIFY_API_KEY=
GOOGLE_PLACES_API_KEY=

# AI & LLM Service Keys (Optional: enables Gemini / Groq live AI Incident Triage)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# Object Storage & Incident Photo Attachments
# Provider options: 'local' (default for dev/test), 'cloudinary' (durable cloud storage), 's3'
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=data/uploads
MAX_ATTACHMENT_SIZE_BYTES=5242880
MAX_ATTACHMENTS_PER_INCIDENT=3
MAX_PAYLOAD_SIZE_BYTES=15728640

# Cloudinary Storage Configuration (Optional - required if STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_URL=

# S3 Storage Configuration (Optional - required if STORAGE_PROVIDER=s3)
S3_BUCKET_NAME=
AWS_REGION=us-east-1
S3_ENDPOINT_URL=
S3_PUBLIC_DOMAIN=
