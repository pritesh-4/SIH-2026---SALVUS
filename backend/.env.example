# ==============================================================================
# SALVUS BACKEND - Environment Variables Template
# Copy this file to `.env` for local development.
# NEVER commit `.env` or real API keys/secrets to version control.
# ==============================================================================

# Server & Runtime Configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# CORS Configuration
# Set to frontend origin in production (e.g. http://localhost:5173 or https://salvus.app)
CORS_ORIGIN=*

# Database Configuration
DATABASE_URL=data/salvus.db

# Security & Secrets (leave empty for local dev defaults)
SECRET_KEY=

# Routing & Geospatial Services
OSRM_BASE_URL=https://router.project-osrm.org

# AI & LLM Service Keys (Optional integrations)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
