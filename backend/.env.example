# ==============================================================================
# SALVUS BACKEND - Environment Variables Template
# Copy this file to `.env` for local development.
# On Render / Production: Set these variables in the Render Dashboard Environment tab.
# NEVER commit `.env` or real API keys/secrets to version control.
# ==============================================================================

# Server & Runtime Configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# CORS Configuration
# Comma-separated allowed origins in production, e.g.:
# CORS_ORIGIN=https://salvus.vercel.app,https://salvus-frontend.onrender.com,http://localhost:5173
CORS_ORIGIN=*

# Database Configuration
# Local/Render free tier: data/salvus.db
# Render persistent disk (Starter tier): /var/data/salvus.db
DATABASE_PATH=data/salvus.db

# Auto-Seeding (set to 'true' to ensure fresh databases seed disaster infrastructure)
AUTO_SEED=true

# Security & Secrets (generate a random 32+ character string in production)
SECRET_KEY=

# Routing & Geospatial Services
OSRM_BASE_URL=https://router.project-osrm.org

# AI & LLM Service Keys (Optional: enables Gemini / Groq live AI Incident Triage)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
