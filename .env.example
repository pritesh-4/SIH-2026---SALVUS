# ==============================================================================
# SALVUS FRONTEND - Environment Variables Template
# Copy this file to `.env` or `.env.local` for local development.
# On Vercel / Netlify / Render: Set these in your project environment settings.
# NEVER commit `.env` or files with real secrets/keys to version control.
# ==============================================================================

# Backend API & WebSocket Endpoint URLs
# Local dev: http://localhost:8000 (or leave empty to proxy)
# Render production backend: https://salvus-backend.onrender.com
VITE_API_URL=http://localhost:8000
VITE_WS_URL=http://localhost:8000

# Mapping & Geospatial Services (Optional Mapbox access token for custom raster layers)
VITE_MAPBOX_TOKEN=

# NOTE: Facility Provider Keys (Geoapify, Google Places) and AI Keys (Gemini, Groq, OpenAI)
# are strictly backend-only to prevent client-side credential exposure.
# Under NO circumstances should provider API keys be exposed in the frontend bundle.
# Configure all provider keys in `backend/.env`.
