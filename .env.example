# ==============================================================================
# SALVUS - Environment Variables Template
# Copy this file to `.env` or `.env.local` for local development.
# NEVER commit `.env` or files with real secrets/keys to version control.
# ==============================================================================

# Backend API endpoint URL
VITE_API_BASE_URL=http://localhost:5000/api

# AI Service Keys (Groq / Gemini / OpenAI)
VITE_GEMINI_API_KEY=
VITE_GROQ_API_KEY=

# Mapping & Geospatial Services (Mapbox / OpenStreetMap)
VITE_MAPBOX_TOKEN=

# Real-time / Database Services (e.g. Supabase / WebSocket)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
