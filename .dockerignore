# Version Control & Metadata
.git
.github
.husky

# Secrets & Environment Configuration (CRITICAL - Prevent credential leakage)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Python Virtual Environments, Bytecode & Caches
venv/
.venv/
env/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/

# Local SQLite Databases & Volatile Runtime Storage
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
data/
backend/data/

# Frontend Dependencies & Build Artifacts
node_modules/
dist/
dist-ssr/
.pnp
.pnp.js

# Test Coverage & Logs
coverage/
*.lcov
.nyc_output/
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

